{
  "manifest_version": 3,
  "name": "ChatSearch: real search for Claude and ChatGPT",
  "short_name": "ChatSearch",
  "version": "1.0.2",
  "description": "Instant full-text, fuzzy and semantic search across every Claude and ChatGPT chat you've had. Local index, no account.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Search your Claude and ChatGPT chats",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "offscreen", "sidePanel", "contextMenus", "activeTab", "clipboardWrite"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "omnibox": { "keyword": "cs" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Open ChatSearch"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
